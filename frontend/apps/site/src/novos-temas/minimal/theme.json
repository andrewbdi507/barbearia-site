  "spacing": { "section": "clamp(3rem, 8vw, 7rem)", "sectionInner": "clamp(2rem, 5vw, 4rem)", "element": "clamp(1rem, 3vw, 2rem)", "card": "1.5rem", "gap": "1.25rem", "gapSmall": "0.75rem", "padding": "1.25rem", "container": "1200px" },
