    "scale": { "display": "clamp(2.5rem, 6vw, 5rem)", "h1": "clamp(2rem, 4.5vw, 3.5rem)", "h2": "clamp(1.5rem, 3vw, 2.5rem)", "h3": "clamp(1.1rem, 2vw, 1.6rem)", "h4": "clamp(1rem, 1.5vw, 1.3rem)", "h5": "0.9rem", "body": "0.95rem", "small": "0.8rem", "caption": "0.7rem" },
    "weight": { "light": 300, "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 },
    "letterSpacing": { "tight": "-0.02em", "normal": "-0.01em", "wide": "0.05em" },
    "lineHeight": { "tight": 1.15, "normal": 1.55, "relaxed": 1.7 }
