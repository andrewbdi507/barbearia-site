{
  "name": "Minimal",
  "version": "1.0.0",
  "author": "AgendaOS Design Team",
  "description": "Tema minimalista e funcional — muito espaço em branco, poucas cores, linhas finas e foco total no conteúdo. Inspirado no design suíço e escandinavo.",
  "category": "minimal",
  "tags": ["clean", "white", "minimal", "functional", "swiss", "scandinavian"],
  "style": { "mood": "Limpo, funcional, sereno", "target": "Barbearias modernas com foco em simplicidade", "inspiration": "Muji, Apple (early), Swiss Design, Scandinavian interiors" },
  "colors": {
    "background": "#FAFAFA", "surface": "#FFFFFF", "surfaceAlt": "#F5F5F5", "surfaceHover": "#EEEEEE",
    "primary": "#1A1A1A", "primaryHover": "#333333", "primaryLight": "rgba(26,26,26,0.06)",
    "secondary": "#666666", "secondaryHover": "#777777",
    "text": "#111111", "textSecondary": "#444444", "textMuted": "#666666", "textInverse": "#FFFFFF",
    "accent": "#1A1A1A", "accentHover": "#333333",
    "border": "rgba(0,0,0,0.08)", "borderLight": "rgba(0,0,0,0.04)",
